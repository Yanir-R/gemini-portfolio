# What `gcloud run deploy --source .` does not upload.
#
# The deploy workflow writes its own copy of this file before deploying, so this
# one governs manual deploys from a developer machine. Keep the two in step.

.git
.gitignore
.github
.vscode
README.md

# Local environment and virtualenvs.
.env*
venv/
.venv/
__pycache__/
*.pyc
*.log

# Test and evaluation assets: not needed to serve traffic, so they stay out of
# the uploaded source and the image built from it.
tests/
evals/
pytest.ini
requirements-dev.txt
