# OS
.DS_Store
Thumbs.db

# Editors
.idea/
*.swp

# Local env files (per-service .gitignore files cover their own)
.env
.env.local

# Agent tooling. settings.local.json accumulates approved shell commands
# verbatim, so it records local paths and whatever was run against directories
# outside this repo. It is ignored here rather than in a machine-level global
# gitignore, which would not travel with a clone, a fork, or a second machine.
.claude/settings.local.json
