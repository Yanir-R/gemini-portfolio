# Local overrides. Copy to .env and set only what you want to differ.
#
# The deployed values are not here. Site URL, backend URL and avatar URL live in
# site.config.ts, committed so that changing one ships with the commit that
# changed it. Anything set here takes precedence over that file, which is what
# makes it useful for local work and preview builds.
#
# .env.development already points `npm run dev` at a local backend, so a fresh
# checkout needs nothing in this file.

# Where the frontend sends API calls.
# VITE_BACKEND_URL=http://localhost:8000

# Public origin used for canonical, OpenGraph, sitemap and llms.txt URLs.
# No trailing slash needed - one is stripped automatically.
# VITE_SITE_URL=http://localhost:3000

# The photograph shown beside the assistant's replies.
#
# The image is not committed: this repository is public and its history
# permanent, so a personal photo in the tree outlives any decision to remove it.
# Production points at an external host through site.config.ts. Locally you can
# drop a file at frontend/public/profile.jpeg, which is gitignored and used only
# by development builds.
#
# Unset is a supported state - the avatar falls back to an initial-letter mark,
# which is what a fresh clone renders.
# VITE_AVATAR_URL=https://example.com/profile.jpg
