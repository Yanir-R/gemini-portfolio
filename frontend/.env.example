# Copy this file to .env and fill in the values
VITE_BACKEND_URL=http://localhost:8000

# Public origin used for canonical/OpenGraph URLs in index.html. Leave unset to
# fall back to the deployed origin; set it to the real domain once confirmed.
# No trailing slash needed - one is stripped automatically.
VITE_SITE_URL=http://localhost:3000

# Optional. URL of the photograph shown beside the assistant's replies.
#
# The image is deliberately not committed: this repository is public and its
# history is permanent, so a personal photo in the tree outlives any decision to
# remove it. Locally, drop the file at frontend/public/profile.jpeg, which is
# gitignored. In production, host it wherever the project screenshots live and
# set this variable in the deploy workflow.
#
# Unset is a supported state: the avatar falls back to an initial-letter mark,
# which is also what a fresh clone renders.
# VITE_AVATAR_URL=https://example.com/profile.jpeg
