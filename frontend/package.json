{
    "name": "frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "Portfolio frontend (React + TypeScript + Vite)",
    "license": "ISC",
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{mts,js,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{mts,js,json}\"",
        "build": "npm run typecheck && vite build",
        "build:dev": "npm run typecheck && vite build --mode development",
        "build:prod": "npm run typecheck && vite build --mode production",
        "preview": "vite preview"
    },
    "dependencies": {
        "axios": "^1.18.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "autoprefixer": "^10.5.4",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^17.7.0",
        "postcss": "^8.5.23",
        "prettier": "^3.6.2",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5"
    },
    "engines": {
        "node": ">=22.22.0",
        "npm": ">=10.8.2"
    }
}
